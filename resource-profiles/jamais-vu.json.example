{
  "schemaVersion": 2,
  "id": "jamais-vu-derived-example",
  "displayName": "My mod",
  "fixedModRoots": ["Starter/MODS/MyMod"],
  "searchParent": "Starter/MODS",
  "directoryNameContains": ["MyMod"],
  "requiredFiles": ["main.lua", "addon.dll"],
  "requiredDirectories": ["res", "Maps"],
  "signatureFiles": ["res/databaseMyMod.res"],
  "resourceDirectories": ["{modRoot}/res", "{gameRoot}/Res"],
  "mapDirectories": ["{modRoot}/Maps", "{gameRoot}/Maps"],
  "providers": {
    "database": "jmv.v1",
    "characterAppearance": "jmv.v1",
    "equipmentLayout": "jmv.v1",
    "unitAnimation": "jmv.v1",
    "semanticValidation": "jmv.v1"
  }
}
