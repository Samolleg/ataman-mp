<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>Ataman.MalachiteHost</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Malachite.Core"><HintPath>$(MalachitePackage)/Malachite.Core.dll</HintPath></Reference>
    <Reference Include="Malachite.UI.Wpf"><HintPath>$(MalachitePackage)/Malachite.UI.Wpf.dll</HintPath></Reference>
    <Reference Include="ModuleContracts.V1"><HintPath>$(ModuleSdk)/ModuleContracts.V1.dll</HintPath></Reference>
    <Reference Include="ModuleContracts.Wpf.V1"><HintPath>$(ModuleSdk)/ModuleContracts.Wpf.V1.dll</HintPath></Reference>
  </ItemGroup>
</Project>
