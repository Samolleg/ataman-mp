diff --git a/external/owned-renderer/Source/brush_ambient_prepared.h b/external/owned-renderer/Source/brush_ambient_prepared.h
new file mode 100644
--- /dev/null
+++ b/external/owned-renderer/Source/brush_ambient_prepared.h
@@ -0,0 +1,53 @@
+#pragma once
+#include "ambient_terrain_grids.h"
+#include "ambient_particle_frame.h"
+#include "ambient_mushroom_sources.h"
+#include "owned_terrain_decode.h"
+#include "liquid_surf.h"
+#include "brush_timing.h"
+
+namespace owned {
+// CPU-only completion. This value never contains a context, renderer or game
+// pointer. The host publishes it only after its world/serial fence still matches.
+struct BrushAmbientPrepared {
+ std::shared_ptr<TerrainCpuAsset> terrain;
+ ambient::TerrainGrids grids;
+ std::vector<std::array<std::uint8_t,4>> sources;
+ std::shared_ptr<const TerrainTileBlendInput> blend_input;
+ std::vector<std::uint32_t> vertex,fold;
+ std::set<std::string> drawable;
+ std::vector<std::array<std::uint32_t,4>> contact,rows;
+ std::map<std::uint32_t,std::uint32_t> cells;
+ std::set<std::uint32_t> unmatched,borrowed;
+ std::size_t blended=0,plain=0,bed=0;
+ bool own_edges=true;
+ std::shared_ptr<const LiquidSurfField> surf;
+};
+inline std::shared_ptr<BrushAmbientPrepared> prepare_brush_ambient(
+ std::shared_ptr<TerrainCpuAsset> terrain,const OwnedMapSnapshot* map,
+ const OwnedTerrainGeometryValues& geometry,const TerrainTileFamilies& families,
+ const std::vector<std::uint32_t>& edges,bool own_edges) {
+ auto out=std::make_shared<BrushAmbientPrepared>();out->terrain=std::move(terrain);out->own_edges=own_edges;
+ BrushStageTimer timer;
+ auto& grids=out->grids;
+ if(!ambient::build_terrain_grids(*out->terrain,map,grids,&geometry))return {};
+ timer.mark("worker_grids");
+ const auto w=grids.tiles_x,h=grids.tiles_y;
+ out->sources.assign(std::size_t(w)*h,{});
+ ambient::mushroom_sources(map,w,h,out->sources);
+ for(std::uint32_t y=0;y<h;++y)for(std::uint32_t x=0;x<w;++x)
+  out->sources[std::size_t(y)*w+x][1]=std::uint8_t(std::lround(ambient::cave_drip_at(grids,x,y)*255.f));
+ ambient::ambient_fall_sources(*out->terrain,&geometry,grids.level.liquid_area,w,out->sources);
+ timer.mark("worker_sources_falls");
+ auto input=std::make_shared<TerrainTileBlendInput>(owned_terrain_tile_blend_input(*out->terrain,w,h));
+ out->vertex=owned_terrain_tile_vertex_families(*input,families);
+ out->drawable=owned_terrain_tile_blend_drawable(*input,families);
+ timer.mark("worker_blend_input");
+ out->rows=owned_terrain_tile_blend_rows(*input,families,own_edges?std::vector<std::uint32_t>{}:edges,
+  out->blended,out->plain,out->bed,out->unmatched,out->fold,out->borrowed,&out->cells,own_edges);
+ std::uint64_t used=0;out->contact=owned_terrain_contact_tiles(*out->terrain,w,h,used);
+ timer.mark("worker_rows_contact");
+ out->blend_input=std::move(input);
+ return out;
+}
+}
diff --git a/external/owned-renderer/Source/brush_attribute_decode.inc b/external/owned-renderer/Source/brush_attribute_decode.inc
new file mode 100644
--- /dev/null
+++ b/external/owned-renderer/Source/brush_attribute_decode.inc
@@ -0,0 +1,83 @@
+// Included in namespace owned after the original decoder. The material
+// values are produced by that decoder once per sector, in its fixed layout.
+std::shared_ptr<const BrushTerrainAttributes> prepare_brush_terrain_attributes(
+ const TerrainCpuAsset& source,std::uint32_t sector_index,std::uint64_t revision,
+ std::shared_ptr<const BrushTerrainAttributes> previous,const std::array<int,4>* dirty){
+ const auto& sector=source.sectors[sector_index];if(!sector.editor_vertices||!sector.editor_shared_vertices)return {};
+ auto out=previous?std::make_shared<BrushTerrainAttributes>(*previous):std::make_shared<BrushTerrainAttributes>();out->revision=revision;out->values.resize(2304);
+ std::array<bool,256> tiles{};tiles.fill(true);
+ if(previous&&dirty)for(unsigned t=0;t<256;++t){const int x=int(sector.map_x*32+t%16*2),y=int(sector.map_y*32+t/16*2);
+  tiles[t]=x+2>=(*dirty)[0]&&x<=(*dirty)[2]&&y+2>=(*dirty)[1]&&y<=(*dirty)[3];
+ }
+ const auto geometry=frozen_owned_terrain_geometry(source);
+ OwnedTerrainDynamicSector dynamic;dynamic.captured=true;dynamic.animation=geometry.animation;
+ std::vector<NativeTextureCoordinate> uv(2304);std::vector<NativeVertexComponent> components(2304);std::vector<std::uint16_t> indices(6144);
+ for(std::uint32_t material=0;material<source.texture_count+2;++material){
+  OwnedTerrainSourceDecodeContext input;input.source=&source;input.sector=&sector;input.material=&sector.materials[material];input.dynamic=&dynamic;input.geometry=&geometry;
+  input.brush_build_attributes=true;input.brush_keep_attributes=true;input.brush_dirty_tiles=previous&&dirty?&tiles:nullptr;input.command.source_sector=sector_index;input.command.material=std::uint16_t(material);input.command.subpart_mask=15;input.command.lod=0;
+  if(!select_owned_terrain_descriptor_counts(*input.material,0,false,false,15,input.command.tile_count,input.command.index_count))return {};
+  if(!input.command.tile_count)continue;input.command.vertex_count=input.command.tile_count*9;
+  NativeGeometryDecodeTarget target{};target.positions=const_cast<NativePackedGroup*>(sector.editor_vertices->positions.data());target.normals=const_cast<NativePackedGroup*>(sector.editor_vertices->normals.data());
+  target.position_groups=target.normal_groups=std::uint32_t(sector.editor_vertices->positions.size());
+  target.texture_coordinates=uv.data();target.texture_coordinate_count=input.command.vertex_count;target.components=components.data();target.component_count=input.command.vertex_count;
+  target.indices=indices.data();target.index_count=input.command.index_count;target.terrain_vertices=out->values.data();target.terrain_vertex_count=2304;
+  if(!owned_terrain_decode_valid(&input,target)||!decode_owned_terrain_tiles(input,target))return {};
+ }
+ for(unsigned tile=0;tile<256;++tile)if(tiles[tile]){out->steep[tile]=false;for(unsigned corner=0;corner<9;++corner){
+  const auto packed=out->values[tile*9+corner].slope_normal;
+  const float x=float(std::int16_t(packed&65535u))/32767.f,y=float(std::int16_t(packed>>16))/32767.f;
+  if(std::sqrt((std::max)(0.f,1.f-x*x-y*y))<kTerrainSteepClassZ)out->steep[tile]=true;
+ }}
+ return out;
+}
+
+std::shared_ptr<const BrushTerrainAttributes> update_brush_liquid_attributes(
+ const TerrainCpuAsset& source,std::uint32_t sector_index,std::uint64_t revision,std::shared_ptr<const BrushTerrainAttributes> previous){
+ if(!previous)return prepare_brush_terrain_attributes(source,sector_index,revision);
+ const auto& sector=source.sectors[sector_index];auto out=std::make_shared<BrushTerrainAttributes>(*previous);out->revision=revision;
+ struct Bed{float depth=0,emission=1;std::uint16_t object=UINT16_MAX;};std::array<Bed,1089> beds{};
+ for(unsigned i=0;i<1089;++i){const auto object=terrain_base_liquid_object(source,sector,i);if(object==UINT16_MAX)continue;
+  beds[i].object=object;beds[i].depth=sector.vertices[i+1089].z-sector.vertices[i].z;beds[i].emission=source.objects[object].self_illumination;
+ }
+ for(unsigned tile=0;tile<256;++tile)for(unsigned corner=0;corner<9;++corner){const auto vertex=(tile/16*2+corner/3)*33+tile%16*2+corner%3;const auto& bed=beds[vertex];auto& value=out->values[tile*9+corner];
+  value.liquid_depth=bed.depth;value.liquid_bed_emission=bed.emission;value.shift_objects=(value.shift_objects&65535u)|(std::uint32_t(bed.object)<<16);
+ }
+ return out;
+}
+
+// Repartitioning a material changes its UV/component/index streams only.
+// XYZ/normals and all native terrain attributes already exist by tile corner.
+bool decode_brush_material_tiles(const OwnedTerrainSourceDecodeContext& input,NativeGeometryDecodeTarget& target){
+ static constexpr std::array<std::array<unsigned,9>,3> lanes{{{{0,1,2,3,4,5,6,7,8}},{{0,2,3,5,6,8,0,0,0}},{{0,2,6,8,0,0,0,0,0}}}};
+ const auto& command=input.command;const auto& sector=*input.sector;const auto& attributes=*sector.editor_attributes;
+ const auto count=terrain_vertices_per_tile(command.lod);if(!count||command.lod>2)return false;
+  std::uint32_t actual_tiles=0,actual_indices=0;
+  if(!select_owned_terrain_descriptor_counts(*input.material,command.lod,command.lu_higher,command.rd_higher,command.subpart_mask,actual_tiles,actual_indices)||
+    actual_tiles*count!=target.component_count||actual_indices!=target.index_count){
+   std::fprintf(stderr,"BRUSH_DECODE_COUNTS sector=%u material=%u mask=%u lod=%u actual=%u/%u target=%u/%u command=%u/%u\n",command.source_sector,command.material,command.subpart_mask,command.lod,actual_tiles*count,actual_indices,target.component_count,target.index_count,command.vertex_count,command.index_count);return false;
+  }
+ unsigned vertex=0,index=0;const bool split=command.material<input.source->texture_count;
+ for(unsigned pass=0;pass<(split?2u:1u);++pass){
+  if(pass==1)target.steep_index_begin=index;
+  for(unsigned part=0;part<4;++part)if(command.subpart_mask&(1u<<part)){
+   const auto& range=input.material->subparts[part];
+   for(unsigned n=range.tile_begin;n<unsigned(range.tile_begin)+range.tile_count;++n){
+    const auto& tile=sector.tiles[n];unsigned x=33,y=33;
+    for(const auto v:tile.vertex_indices){x=(std::min)(x,unsigned(v%33u));y=(std::min)(y,unsigned((v%1089u)/33u));}
+    const auto slot=y/2*16+x/2;if(slot>=256)return false;
+    if(split&&attributes.steep[slot]!=(pass==1))continue;
+    const auto tex=terrain_tile_uvs(*input.source,tile);const auto base=vertex;
+     if(vertex+count>target.component_count){std::fprintf(stderr,"BRUSH_DECODE_OVERFLOW sector=%u material=%u slot=%u vertex=%u target=%u pass=%u steep=%d\n",command.source_sector,command.material,slot,vertex,target.component_count,pass,int(attributes.steep[slot]));return false;}
+    for(unsigned j=0;j<count;++j){const auto lane=lanes[command.lod][j],canonical=slot*9+lane;
+     target.texture_coordinates[vertex]=tex[lane];target.components[vertex]={std::uint16_t(canonical),std::uint16_t(canonical),std::uint16_t(vertex)};++vertex;
+    }
+    const auto topology=terrain_index_template(command.lod,tile.edge_mask,command.lu_higher,command.rd_higher);
+     if(index+topology.count>target.index_count){std::fprintf(stderr,"BRUSH_DECODE_INDEX_OVERFLOW sector=%u material=%u index=%u add=%u target=%u\n",command.source_sector,command.material,index,topology.count,target.index_count);return false;}
+    for(unsigned j=0;j<topology.count;++j)target.indices[index++]=std::uint16_t(base+topology.indices[j]);
+   }
+  }
+ }
+ if(!split)target.steep_index_begin=index;
+  if(vertex!=target.component_count||index!=target.index_count){std::fprintf(stderr,"BRUSH_DECODE_SHORT sector=%u material=%u vertex=%u/%u index=%u/%u\n",command.source_sector,command.material,vertex,target.component_count,index,target.index_count);return false;}
+  return true;
+}
diff --git a/external/owned-renderer/Source/brush_d3d_counts.h b/external/owned-renderer/Source/brush_d3d_counts.h
new file mode 100644
--- /dev/null
+++ b/external/owned-renderer/Source/brush_d3d_counts.h
@@ -0,0 +1,34 @@
+#pragma once
+// Diagnostic counters for explicit Create* calls. Native COM identities and
+// device interfaces are preserved. A private IUnknown tag counts final release.
+#include <d3d11.h>
+#include <wrl/client.h>
+#include <array>
+#include <atomic>
+#include <memory>
+struct BrushD3DCounts {
+ enum Kind {Buffer,Texture2D,SRV,RTV,Count};
+ struct Counts {std::atomic<uint64_t> live[Count]{},created[Count]{},peak[Count]{},tagErrors{0};};
+ inline static const GUID key={0x18b250b7,0x2882,0x485e,{0x83,0x19,0x77,0x50,0x6a,0x91,0xf8,0x2c}};
+ static bool enabled(){static const bool yes=GetEnvironmentVariableW(L"ATAMAN_BRUSH_D3D_COUNTS",nullptr,0)!=0;return yes;}
+ static std::shared_ptr<Counts> state(){static auto value=std::make_shared<Counts>();return value;}
+ struct Tag final:IUnknown {
+  std::atomic<ULONG> refs{1};std::shared_ptr<Counts> counts;unsigned kind;
+  explicit Tag(unsigned k):counts(state()),kind(k){auto n=++counts->live[k];++counts->created[k];auto p=counts->peak[k].load();while(n>p&&!counts->peak[k].compare_exchange_weak(p,n)){} }
+  ~Tag(){--counts->live[kind];}
+  HRESULT STDMETHODCALLTYPE QueryInterface(REFIID iid,void** out) override {if(!out)return E_POINTER;*out=nullptr;if(iid!=__uuidof(IUnknown))return E_NOINTERFACE;*out=this;AddRef();return S_OK;}
+  ULONG STDMETHODCALLTYPE AddRef() override{return ++refs;}
+  ULONG STDMETHODCALLTYPE Release() override{auto n=--refs;if(!n)delete this;return n;}
+ };
+ template<class T> static HRESULT tag(HRESULT hr,T** out,unsigned kind){if(enabled()&&SUCCEEDED(hr)&&out&&*out){auto* t=new Tag(kind);if(FAILED((*out)->SetPrivateDataInterface(key,t)))++state()->tagErrors;t->Release();}return hr;}
+ static void snapshot(uint64_t* out){auto c=state();for(unsigned i=0;i<Count;++i){out[i]=c->live[i];out[4+i]=c->created[i];out[8+i]=c->peak[i];}out[12]=c->tagErrors;}
+};
+struct BrushCountDevice {
+ ID3D11Device* device;
+ HRESULT CreateBuffer(const D3D11_BUFFER_DESC* desc,const D3D11_SUBRESOURCE_DATA* initial,ID3D11Buffer** out)const{return BrushD3DCounts::tag(device->CreateBuffer(desc,initial,out),out,BrushD3DCounts::Buffer);}
+ HRESULT CreateTexture2D(const D3D11_TEXTURE2D_DESC* desc,const D3D11_SUBRESOURCE_DATA* initial,ID3D11Texture2D** out)const{return BrushD3DCounts::tag(device->CreateTexture2D(desc,initial,out),out,BrushD3DCounts::Texture2D);}
+ HRESULT CreateShaderResourceView(ID3D11Resource* resource,const D3D11_SHADER_RESOURCE_VIEW_DESC* desc,ID3D11ShaderResourceView** out)const{return BrushD3DCounts::tag(device->CreateShaderResourceView(resource,desc,out),out,BrushD3DCounts::SRV);}
+ HRESULT CreateRenderTargetView(ID3D11Resource* resource,const D3D11_RENDER_TARGET_VIEW_DESC* desc,ID3D11RenderTargetView** out)const{return BrushD3DCounts::tag(device->CreateRenderTargetView(resource,desc,out),out,BrushD3DCounts::RTV);}
+};
+inline BrushCountDevice brush_count_device(ID3D11Device* device){return {device};}
+template<class T> inline BrushCountDevice brush_count_device(const Microsoft::WRL::ComPtr<T>& device){return {device.Get()};}
