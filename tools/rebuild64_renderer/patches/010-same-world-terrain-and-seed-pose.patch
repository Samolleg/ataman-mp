+                if(whole(piece.selection)&&touches(selection,piece.selection))dependencies.push_back(welded[other]?welded[other].get():piece.brush->forecast.get());
+            }
+        }
+        const auto liquid_basis=whole(selection)?brush_liquid_dependencies(dependencies):0;
+        const bool liquid_changed=liquid_basis!=cache.liquid_basis&&brush_neighbour_liquid_changed(cache,index,pieces,welded,*active,active_rim);
+        const bool geometry_changed=basis!=cache.basis;
+        const bool finalize=(flags&8)&&(cache.pending_global||cache.pending_finish);
+        const bool changed=geometry_changed||liquid_changed||finalize;
+        if(!changed){
+            cache.liquid_basis=liquid_basis;
