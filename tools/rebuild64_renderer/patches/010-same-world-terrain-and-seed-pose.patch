+bool RetainedStaticScene::editor_replace_terrain(std::shared_ptr<const OwnedMapSnapshot> next) noexcept {
+    if(!next||!next->terrain||!next->terrain->immutable_descriptor_validated)return false;
+    ExclusiveLock guard(lock_);
+    for(auto& s:sources_)if(s.role==MobSourceRole::main&&s.snapshot) {
+        if(s.snapshot->generation!=next->generation||s.snapshot->terrain_resource!=next->terrain_resource)return false;
+        // Retail terrains are immutable: structural_revision originally only
+        // advanced for a different wind-noise structure. An editor replacement
+        // changes caster membership/positions too. Announce that content change
+        // to retained shadow domains without changing resource identity keys.
+        auto geometry=s.terrain_geometry;
+        if(geometry&&!next->terrain->editor_defer_shadows){
+            const auto revision=s.terrain_geometry_serial+1;if(!revision)return false;
+            try{auto edited=std::make_shared<OwnedTerrainGeometryValues>(*geometry);
+                edited->revision=edited->structural_revision=revision;geometry=std::move(edited);
+            }catch(...){return false;}
+            std::fprintf(stderr,"BRUSH_TERRAIN_STRUCTURE source=%llu old=%llu new=%llu\n",source_generation_,s.terrain_geometry->structural_revision,revision);
+            s.terrain_geometry_serial=revision;
+        }
+        // DepthValues held only transform/cull/alpha for immutable retail
+        // maps. Cached depth revisions must also retire edited MPR geometry.
+        if(!next->terrain->editor_defer_shadows&&s.terrain_prepared&&s.snapshot->terrain){
+            std::size_t retired=0;std::uint64_t first=0;
+            for(auto& entry:s.terrain_prepared->parts){const auto sector=entry.first[0];
+                if(sector>=next->terrain->sectors.size()||sector>=s.snapshot->terrain->sectors.size())continue;
+                const auto revision=next->terrain->sectors[sector].editor_revision;
+                if(revision==entry.second.depth_editor_revision)continue;
+                entry.second.depth_editor_revision=revision;
+                if(!first)first=entry.second.depth_revision;entry.second.depth_revision=0;++retired;
+            }
