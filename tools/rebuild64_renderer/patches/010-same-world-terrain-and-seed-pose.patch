+// Included in Renderer::brush_update_neighbours, after update_grid.
+    if(state.brush_work){
+        auto work=state.brush_work;
+        if(work->future.wait_for(std::chrono::seconds(0))!=std::future_status::ready)return S_OK;
+        auto batch=work->future.get();state.brush_work.reset();
+        const bool current=!work->cancel->load()&&work->epoch==state.epoch&&work->active==state.brush_terrain;
+        if(current&&batch){
+            if(!batch->failure.empty()){bridge_neighbour_diagnostic(batch->failure.c_str());return E_FAIL;}
+            const auto adopt_start=std::chrono::steady_clock::now();
+            for(auto& ready:batch->entries){
+                auto& resident=*state.brush_pieces[ready.index];auto& replacement=ready.replacement;
+                adopt_prebuilt_pages(replacement);
+        struct Submission {Renderer* renderer;const FixedState* frame;};Submission submission{this,&frame};
+        const auto submit=[](void* opaque,const NativeGeometryView& input,NativeGeometryResult& result)->bool {
+            auto& s=*static_cast<Submission*>(opaque);auto& self=*s.renderer;
+            const auto first=self.native_pending_draws_.size();
+            const auto fixed=neighbour_submission_state(*s.frame,input.semantic_kind,input.ordering);
+            const auto hr=self.queue_native_terrain(input,fixed,nullptr,&result);
+            if(FAILED(hr)){char text[256];std::snprintf(text,sizeof(text),"BRUSH_WELD queue hr=%08x operation=%s part=%u",unsigned(hr),result.failure_operation?result.failure_operation:"unknown",input.prepared_identity.part_index);bridge_neighbour_diagnostic(text);return false;}
+            if(input.ordering!=NativeOrdering::preserve){bool registered=false;
+                return SUCCEEDED(self.adopt_native_static_draws(self.neighbours_.opaque,input.prepared_identity.part_index,first,registered))&&registered;
+            }
+            for(std::size_t i=first;i<self.native_pending_draws_.size();++i){const auto record=self.native_pending_draws_[i];
+                --self.native_instance_records_[record.record].command.mesh->pending_references;self.neighbours_.ordered.push_back(record);}
+            self.native_pending_draws_.resize(first);return true;
+        };
+        // Prepared replacements exist before removing any published ordered draw.
+        for(const auto& draw:replacement.terrain)if(!draw.reorderable){
+            for(auto i=state.ordered.begin();i!=state.ordered.end();){
+                if(std::find(draw.brush_records.begin(),draw.brush_records.end(),i->record)==draw.brush_records.end()){++i;continue;}
+                release_native_queued_draw(i->record,false);i=state.ordered.erase(i);
+            }
+        }
+        const char* reason=nullptr;const bool submitted=submit_neighbour_terrain(replacement,world_to_clip,submit,&submission,reason);
+        release_unused_prebuilt(replacement);if(!submitted)return failed(__LINE__);
+        for(auto& draw:replacement.terrain)for(auto& previous:resident.terrain)
+            if(previous.sector==draw.sector&&previous.material==draw.material){previous.brush_records=std::move(draw.brush_records);previous.brush_mesh=draw.brush_mesh;previous.brush_skin=draw.brush_skin;break;}
+
+                if(ready.grids)for(auto& n:gc_neighbours_)if(n.contact_map==resident.brush_contact_map){
+                    const auto& grids=ready.snapshot->ground_cover->grids;
+                    if(!update_grid(n.area,grids.area.data(),grids.tiles_x)||!update_grid(n.height,grids.height.data(),(grids.tiles_x*2+1)*4)||!update_grid(n.ground,grids.ground.data(),(grids.tiles_x*2+1)*4))return failed(__LINE__);
+                    n.prepared=false;
+                    for(std::size_t t=0;t<n.tile_classes.size();++t)n.tile_classes[t]=(n.tile_classes[t]&~255u)|grids.area[t];
+                    n.masks_key=UINT64_MAX;
+                    if(ready.snapshot->ground_cover->blend_input&&n.blend_families){
+                        n.blend_input=ready.snapshot->ground_cover->blend_input;
+                        n.blend_vertex=owned_terrain_tile_vertex_families(*n.blend_input,*n.blend_families);
+                        n.blend_drawable=owned_terrain_tile_blend_drawable(*n.blend_input,*n.blend_families);
+                        n.blend_rows=false;
+                    }
+                    break;
