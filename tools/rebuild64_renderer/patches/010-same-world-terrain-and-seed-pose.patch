+    std::vector<std::shared_ptr<const TerrainLiquidRim>> welded(pieces.size());
+    const auto whole=[](const NeighbourSelection& n){return n.x==std::floor(n.x)&&n.y==std::floor(n.y);};
+    for(std::size_t index=0;index<pieces.size();++index){
+        auto& resident=*pieces[index];auto& cache=*resident.brush;
+        const auto& selection=resident.selection;
+        const auto basis=brush_neighbour_basis(*cache.original,selection.x,selection.y,strips);
+        auto dirty=brush_neighbour_dirty(cache,selection.x,selection.y,strips);
+        const auto touches=[](const NeighbourSelection& a,const NeighbourSelection& b){return a.x<=b.x+b.placement.width&&b.x<=a.x+a.placement.width&&a.y<=b.y+b.placement.height&&b.y<=a.y+a.placement.height;};
+        std::vector<const TerrainLiquidRim*> dependencies;
