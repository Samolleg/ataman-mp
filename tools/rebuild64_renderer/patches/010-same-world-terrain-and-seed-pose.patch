+// CPU/native-prebuilt preparation on the background thread. Only the
+// ID3D11Device is used; no context, renderer, queue or published cache access.
+static std::shared_ptr<BrushNeighbourBatch> prepare_brush_neighbours(
+ const std::shared_ptr<const TerrainCpuAsset>& active,std::uint32_t flags,
+ std::vector<std::shared_ptr<NeighbourPiece>> pieces,ComPtr<ID3D11Device> device,
+ const std::shared_ptr<std::atomic<bool>>& cancel,const std::string& no_sea){
+ auto batch=std::make_shared<BrushNeighbourBatch>();
