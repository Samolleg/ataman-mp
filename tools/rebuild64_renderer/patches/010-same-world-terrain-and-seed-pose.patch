--- /dev/null
+++ b/external/owned-renderer/Source/brush_neighbour_source.h
@@ -0,0 +1,160 @@
+#pragma once
+#include "neighbour_maps.h"
+#include "owned_terrain_front_end.h"
+#include "liquid_surface_shader.h"
+#include <stdexcept>
+#include <set>
+#include <cmath>
+
+namespace owned {
+// Private embedded edit state. No decoded interior mesh, material pixels or
+// open map file survives adoption. Only border SEC members and a height grid.
+struct BrushNeighbourSource {
+    std::shared_ptr<TerrainCpuAsset> original;
+    std::map<std::uint32_t,ResourceBlob> border;
+    std::shared_ptr<const TerrainLiquidRim> forecast;
+    std::shared_ptr<const TerrainLiquidRim> rim;
+    std::vector<NeighbourEdgeStrip> strips;
+    std::vector<NeighbourEdgeStrip> basis_strips;
+    std::wstring path;
+    std::uint64_t revision=0;
+    std::uint64_t basis=0;
+    bool pending_global=false;
+    bool pending_finish=false;
+    std::uint64_t liquid_basis=0;
+    std::uint64_t outside_basis=0;
+};
+inline std::uint64_t brush_outside_liquid_hash(const TerrainCpuAsset& terrain){
+ const auto& outside=terrain.outside_liquid;std::uint64_t hash=1469598103934665603ull;
+ const auto bytes=[&](const void* data,size_t n){const auto* p=static_cast<const uint8_t*>(data);while(n--){hash^=*p++;hash*=1099511628211ull;}};
+ bytes(&outside.reach,sizeof(outside.reach));
+ const int r=outside.reach,w=int(terrain.sector_count_x*32)+1+2*r,h=int(terrain.sector_count_y*32)+1+2*r;
+ if(r>0&&outside.heights.size()==size_t(w)*h)for(int y=0;y<h;++y){
+  if(y<r||y>=h-r)bytes(outside.heights.data()+size_t(y)*w,size_t(w)*4);
+  else {bytes(outside.heights.data()+size_t(y)*w,size_t(r)*4);bytes(outside.heights.data()+size_t(y)*w+w-r,size_t(r)*4);}
+ }
+ for(unsigned side=0;side<4;++side){
+  for(const auto& f:outside.edge_flow[side]){bytes(f.current,sizeof(f.current));bytes(f.downstream,sizeof(f.downstream));bytes(&f.bend,5*sizeof(float));bytes(&f.valid,sizeof(f.valid));}
+  for(const auto& s:outside.seams[side]){bytes(&s.seam,sizeof(s.seam));bytes(&s.running,sizeof(s.running));bytes(&s.role,sizeof(s.role));bytes(&s.level,3*sizeof(float));}
+ }return hash;
+}
+// A change elsewhere on an adjoining map's perimeter cannot affect this map.
+// Compare exactly the native outside field projected into this map's edges.
+template<class Pieces>
+inline bool brush_neighbour_liquid_changed(const BrushNeighbourSource& cache,size_t index,const Pieces& pieces,
+ const std::vector<std::shared_ptr<const TerrainLiquidRim>>& welded,const TerrainCpuAsset& active,const TerrainLiquidRim& active_rim){
+ const auto& selection=pieces[index]->selection;TerrainCpuAsset probe=*cache.original;
+ std::vector<TerrainAdjoiningLiquid> beside;
+ TerrainAdjoiningLiquid a;a.offset_x=int(selection.x);a.offset_y=int(selection.y);
+ a.xmax=int(active.sector_count_x*32);a.ymax=int(active.sector_count_y*32);a.rim=active_rim.heights.empty()?nullptr:&active_rim;a.flows=a.fixed=true;beside.push_back(a);
+ for(size_t other=0;other<pieces.size();++other){if(other==index)continue;const auto& piece=*pieces[other];
+  if(piece.selection.x!=std::floor(piece.selection.x)||piece.selection.y!=std::floor(piece.selection.y))continue;
+  TerrainAdjoiningLiquid n;n.offset_x=int(selection.x-piece.selection.x);n.offset_y=int(selection.y-piece.selection.y);
+  n.xmax=int(piece.selection.placement.width);n.ymax=int(piece.selection.placement.height);
+  n.rim=welded[other]?welded[other].get():piece.brush->forecast.get();n.flows=bool(welded[other]);beside.push_back(n);
+ }
+ owned_terrain_set_outside_liquid(probe,beside,cache.forecast.get());
+ return brush_outside_liquid_hash(probe)!=cache.outside_basis;
+}
+inline std::uint64_t brush_liquid_rim_hash(const TerrainLiquidRim* rim){
+    if(!rim||rim->heights.empty())return 0;
+    std::uint64_t hash=1469598103934665603ull;
+    const auto bytes=[&](const void* data,std::size_t count){const auto* p=static_cast<const unsigned char*>(data);while(count--){hash^=*p++;hash*=1099511628211ull;}};
+    // Exactly the maximum reach read by owned_terrain_set_outside_liquid.
+    const int reach=int(kLiquidCascadeReach),width=rim->xmax+1;
+    for(int y=0;y<=rim->ymax;++y){
+        if(y<=reach||y>=rim->ymax-reach)bytes(rim->heights.data()+std::size_t(y)*width,width*sizeof(float));
+        else{const int count=(std::min)(reach+1,width);bytes(rim->heights.data()+std::size_t(y)*width,count*sizeof(float));bytes(rim->heights.data()+std::size_t(y)*width+width-count,count*sizeof(float));}
+    }
