+bool RetainedStaticScene::editor_seed_pose(std::int32_t id,const VisualObjectPose& pose,bool defer_shadow) noexcept {
+    std::array<float,16> matrix{};
+    if(!retained_object_matrix(pose.position,pose.quaternion,matrix))return false;
+    for(float v:pose.shape)if(!std::isfinite(v))return false;
+    ExclusiveLock guard(lock_);auto found=detached_.find(id);
+    if(found==detached_.end()||!found->second.seeded)return false;
+    auto& e=found->second.entity;
+    if(e.object_pose.position==pose.position&&e.object_pose.quaternion==pose.quaternion&&e.object_pose.shape==pose.shape)return true;
+    e.object_pose=pose;e.has_object_pose=true;++e.pose_revision;
+    e.editor_pose_revision=e.pose_revision;
+    if(!visual_refresh_envelope(e,false))return false;
+    visual_frame_changed_unlocked();
+    // Grounded figures follow colour geometry immediately. A brush retains the
+    // completed shadow domain until its final terrain publication, including
+    // every moved figure rather than rebuilding all cascades on every stamp.
+    if(defer_shadow){try{editor_deferred_shadow_poses_.insert(id);}catch(...){shadow_source_changed_unlocked(id);}}
+    else {editor_deferred_shadow_poses_.erase(id);shadow_source_changed_unlocked(id);}
+    detached_changed_unlocked();return true;
+}
