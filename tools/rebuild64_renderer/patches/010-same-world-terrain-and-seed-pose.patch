diff --git a/external/owned-renderer/Source/brush_vertex_gpu.inc b/external/owned-renderer/Source/brush_vertex_gpu.inc
new file mode 100644
--- /dev/null
+++ b/external/owned-renderer/Source/brush_vertex_gpu.inc
@@ -0,0 +1,48 @@
+// Persistent XYZ/normal spans are independent of draw membership and their
+// allocator lifetime is the embedded world, not the stamp or material draw.
+HRESULT Renderer::brush_vertex_gpu(UINT page_index,const BrushVertexStreams& source,const BrushTerrainAttributes* attributes,UINT& position,UINT& normal,UINT& terrain){
+ if(!attributes||attributes->values.size()!=2304||d3d12_||page_index>=native_geometry_pages_.size())return E_INVALIDARG;
+ auto& page=native_geometry_pages_[page_index];if(page.dedicated)return E_INVALIDARG;
+ const UINT bytes=UINT(source.positions.size()*sizeof(NativePackedGroup));
+ const auto key=std::make_pair(source.resource,page_index);auto found=brush_vertex_gpu_.find(key);
+ if(found==brush_vertex_gpu_.end()){
+  // Allocate in the draw's raw page, since the unchanged shader binds one raw
+  // buffer for all streams. General arena growth preserves the old offsets.
+  const UINT total=bytes*2+UINT(attributes->values.size()*sizeof(NativeTerrainVertex));NativeGeometrySpan span;UINT offset=0;
+  auto free=std::find_if(page.free.begin(),page.free.end(),[&](const auto& slot){return slot.bytes>=total;});
+  if(free!=page.free.end()){
+   offset=free->offset;if(free->bytes==total)page.free.erase(free);else{free->offset+=total;free->bytes-=total;}
+  }else{
+   if(total>native_geometry_page_limit()-page.high_water)return E_OUTOFMEMORY;
+   const auto hr=ensure_native_geometry_page_capacity(page_index,page.high_water+total);if(FAILED(hr))return hr;
+   offset=page.high_water;page.high_water+=total;
+  }
+  native_geometry_live_bytes_+=total;native_mesh_resident_bytes_=native_geometry_live_bytes_;
+  BrushVertexGpu entry;entry.span={page_index,offset,total};entry.revision=UINT64_MAX;
+  found=brush_vertex_gpu_.emplace(key,entry).first;++brush_vertex_creates_;
+ }
+ auto& entry=found->second;
+ if(entry.revision!=source.revision){
+  const auto resident=std::find_if(brush_vertex_gpu_.begin(),brush_vertex_gpu_.end(),[&](const auto& other){return other.first.first==source.resource&&other.first.second!=page_index&&other.second.revision==source.revision;});
+  if(resident!=brush_vertex_gpu_.end()){
+   const auto& previous=resident->second.span;const D3D11_BOX box{previous.offset,0,0,previous.offset+bytes*2,1,1};
+   context_->CopySubresourceRegion(page.buffer.Get(),0,entry.span.offset,0,0,native_geometry_pages_[previous.page].buffer.Get(),0,&box);
+   std::fprintf(stderr,"BRUSH_VERTEX_GPU_COPY from=%u to=%u bytes=%u\n",previous.page,page_index,bytes*2);
+  }else{
+   auto hr=upload_native_geometry(page_index,entry.span.offset,source.positions.data(),bytes);if(FAILED(hr))return hr;
+   hr=upload_native_geometry(page_index,entry.span.offset+bytes,source.normals.data(),bytes);if(FAILED(hr))return hr;
+   ++brush_vertex_uploads_;brush_vertex_upload_bytes_+=bytes*2;
+  }
+  entry.revision=source.revision;
+ }
+ const UINT attribute_bytes=UINT(attributes->values.size()*sizeof(NativeTerrainVertex));
+ if(entry.attribute_revision!=attributes->revision){
+  const auto resident=std::find_if(brush_vertex_gpu_.begin(),brush_vertex_gpu_.end(),[&](const auto& other){return other.first.first==source.resource&&other.first.second!=page_index&&other.second.attribute_revision==attributes->revision;});
+  if(resident!=brush_vertex_gpu_.end()){
+   const auto& previous=resident->second.span;const D3D11_BOX box{previous.offset+bytes*2,0,0,previous.offset+bytes*2+attribute_bytes,1,1};
+   context_->CopySubresourceRegion(page.buffer.Get(),0,entry.span.offset+bytes*2,0,0,native_geometry_pages_[previous.page].buffer.Get(),0,&box);
+  }else{const auto hr=upload_native_geometry(page_index,entry.span.offset+bytes*2,attributes->values.data(),attribute_bytes);if(FAILED(hr))return hr;}
+  entry.attribute_revision=attributes->revision;
+ }
+ position=entry.span.offset;normal=entry.span.offset+bytes;terrain=entry.span.offset+bytes*2;return S_OK;
+}
diff --git a/external/owned-renderer/Source/brush_vertex_streams.h b/external/owned-renderer/Source/brush_vertex_streams.h
new file mode 100644
--- /dev/null
+++ b/external/owned-renderer/Source/brush_vertex_streams.h
@@ -0,0 +1,35 @@
+#pragma once
+#include "engine_bridge.h"
+#include "owned_asset_loader.h"
+namespace owned {
+// Base-sector XYZ/normals are independent of material/page membership. They
+// are built at initial decode or sculpt, then shared by every material/LOD.
+struct BrushVertexStreams {
+ std::string resource;
+ std::uint64_t revision=0;
+ std::vector<NativePackedGroup> positions,normals;
+};
+struct BrushTerrainAttributes {
+ std::uint64_t revision=0;
+ std::vector<NativeTerrainVertex> values;
+ std::array<bool,256> steep{};
+};
+inline std::shared_ptr<const BrushVertexStreams> prepare_brush_vertex_streams(const TerrainSectorCpuAsset& sector,std::uint64_t revision){
+ if(sector.vertices.size()<1089)return {};
+ auto out=std::make_shared<BrushVertexStreams>();out->resource=sector.identity.key();out->revision=revision;
+ // The native shader addresses terrain attributes with component.position.
+ // A fixed tile-corner index preserves per-tile animation/long-tile flags at
+ // a shared geometric vertex, without changing that shader contract.
+ out->positions.resize(256*9/4);out->normals.resize(out->positions.size());
+ for(std::size_t i=0;i<256*9;++i){const auto tile=i/9,corner=i%9;
+  const auto vertex=(tile/16*2+corner/3)*33+tile%16*2+corner%3;
+  const auto& v=sector.vertices[vertex];const auto group=i>>2,lane=i&3;
+  auto& p=out->positions[group];p.x[lane]=v.x;p.y[lane]=v.y;p.z[lane]=v.z;p.w[lane]=1;
+  auto& n=out->normals[group];n.x[lane]=v.normal_x;n.y[lane]=v.normal_y;n.z[lane]=v.normal_z;
+ }
+ return out;
+}
+inline bool brush_vertex_layout(const TerrainCpuAsset& source,const TerrainSectorCpuAsset& sector,std::uint32_t material){
+ return sector.editor_shared_vertices&&sector.editor_vertices&&material<source.texture_count+2u;
+}
+}
