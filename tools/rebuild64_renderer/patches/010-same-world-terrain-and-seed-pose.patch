diff --git a/external/owned-renderer/Source/brush_neighbour_grids.inc b/external/owned-renderer/Source/brush_neighbour_grids.inc
new file mode 100644
--- /dev/null
+++ b/external/owned-renderer/Source/brush_neighbour_grids.inc
@@ -0,0 +1,43 @@
+// Keep full-size destination grids, but decode only the changed sector box
+// plus one unchanged sector of halo. End uses the original full builder.
+static bool brush_neighbour_grids(const TerrainCpuAsset& terrain,const std::set<uint32_t>& dirty,
+ const ambient::TerrainGrids& previous,ambient::TerrainGrids& out,std::array<UINT,4>& rectangle){
+ if(dirty.empty())return false;
+ const UINT w=terrain.sector_count_x*16,h=terrain.sector_count_y*16,vw=w*2+1;
+ if(previous.area.size()!=size_t(w)*h||previous.height.size()!=size_t(vw)*(h*2+1))return false;
+ UINT sx=terrain.sector_count_x,sy=terrain.sector_count_y,ex=0,ey=0;
+ for(auto i:dirty){const UINT x=i%terrain.sector_count_x,y=i/terrain.sector_count_x;
+  sx=std::min(sx,x?x-1:0);sy=std::min(sy,y?y-1:0);
+  ex=std::max(ex,std::min(terrain.sector_count_x,x+2));ey=std::max(ey,std::min(terrain.sector_count_y,y+2));
+ }
+ TerrainCpuAsset selected=terrain;selected.sectors.clear();
+ for(UINT y=sy;y<ey;++y)for(UINT x=sx;x<ex;++x)selected.sectors.push_back(terrain.sectors[size_t(y)*terrain.sector_count_x+x]);
+ ambient::TerrainGrids local;if(!ambient::build_terrain_grids(selected,nullptr,local))return false;
+ const UINT l=sx*16,t=sy*16,r=ex*16,b=ey*16;rectangle={l,t,r,b};out=previous;
+ for(UINT y=t;y<b;++y)for(UINT x=l;x<r;++x){const auto i=size_t(y)*w+x;
+  out.level.dry_area[i]=local.level.dry_area[i];out.level.liquid_area[i]=local.level.liquid_area[i];out.types[i]=local.types[i];
+ }
+ // The unchanged outer halo boundary keeps the full builder's last-sector
+ // ownership, including maps with authored duplicate edge vertices.
+ const UINT vl=l?l*2+1:0,vt=t?t*2+1:0,vr=r==w?r*2:r*2-1,vb=b==h?b*2:b*2-1;
+ for(UINT y=vt;y<=vb;++y)for(UINT x=vl;x<=vr;++x){const auto i=size_t(y)*vw+x;
+  out.level.ground[i]=local.level.ground[i];out.ground[i]=local.ground[i];out.height[i]=local.height[i];
+ }
+ const auto vertex_inside=[&](UINT i){const auto x=i%vw,y=i/vw;return x>=vl&&x<=vr&&y>=vt&&y<=vb;};
+ auto& vertices=out.level.vertices;vertices.erase(std::remove_if(vertices.begin(),vertices.end(),[&](const auto& v){return vertex_inside(v.cell);}),vertices.end());
+ for(auto v:local.level.vertices)if(vertex_inside(v.cell))vertices.push_back(v);
+ const auto tile_inside=[&](UINT i){const auto x=i%w,y=i/w;return x>=l&&x<r&&y>=t&&y<b;};
+ auto& tiles=out.level.tiles;tiles.erase(std::remove_if(tiles.begin(),tiles.end(),[&](const auto& v){return tile_inside(v.tile);}),tiles.end());
+ for(auto v:local.level.tiles)if(tile_inside(v.tile))tiles.push_back(v);
+ std::sort(tiles.begin(),tiles.end(),[](const auto& a,const auto& b){return a.tile<b.tile;});
+ out.area=out.level.dry_area;
+ if(!ambient::apply_liquid_level(out.level,nullptr,out.height,out.area,out.emissive))return false;
+ if(GetEnvironmentVariableW(L"ATAMAN_BRUSH_NEIGHBOR_GRID_COMPARE",nullptr,0)){
+  ambient::TerrainGrids full;if(!ambient::build_terrain_grids(terrain,nullptr,full))throw std::runtime_error("full neighbour grid comparison failed");
+  size_t different=0;for(size_t i=0;i<full.area.size();++i)different+=(full.area[i]&15u)!=(out.area[i]&15u);
+  for(size_t i=0;i<full.height.size();++i)different+=full.height[i]!=out.height[i]||full.ground[i]!=out.ground[i];
+  std::fprintf(stderr,"BRUSH_NEIGHBOR_GRID_COMPARE sectors=%zu selected=%u different=%zu\n",dirty.size(),(ex-sx)*(ey-sy),different);
+  if(different)throw std::runtime_error("local neighbour grids differ from native full grids");
+ }
+ return true;
+}
