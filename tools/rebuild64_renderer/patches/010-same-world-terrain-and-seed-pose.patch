+            continue;
+        }
+        if(cancel->load())return {};
+        const auto started=std::chrono::steady_clock::now();
+        if(liquid_changed||((flags&8)&&cache.pending_global))for(const auto& entry:cache.border){
+            const auto& sector=cache.original->sectors[entry.first];
+            const bool border=!sector.map_x||!sector.map_y||sector.map_x+1==cache.original->sector_count_x||sector.map_y+1==cache.original->sector_count_y;
+            if(sector.has_layers&&((flags&8)||border))dirty.insert(entry.first);
+        }
+        bool touches_liquid=liquid_changed;
+        for(const auto sector:dirty)for(const auto& tile:cache.original->sectors[sector].tiles)
+            if(tile.transparent&&tile.object_id<cache.original->objects.size()&&terrain_liquid_object(cache.original->objects[tile.object_id].type)){touches_liquid=true;break;}
+        auto terrain=std::make_shared<TerrainCpuAsset>(*cache.original);
+        ResourceFailure failure;
+        for(const auto& [sector,blob]:cache.border){
+            if(cancel->load())return {};
+            if(!dirty.count(sector))continue;
+            auto& data=terrain->sectors[sector];const auto identity=data.identity;
+            if(!parse_terrain_sector_asset(blob,*terrain,data.map_x,data.map_y,data,failure))throw std::runtime_error("neighbour brush CPU preparation failed");
+            data.identity=identity;data.editor_revision=cache.revision+1;
+            // Complete loading flattens the authored liquid rim and prepares
+            // command envelopes before the native neighbour weld. Restore
+            // that same pre-weld state; SEC alone is earlier in the pipeline.
+            const auto& original=cache.original->sectors[sector];
+            for(std::size_t v=1089;v<data.vertices.size();++v)data.vertices[v].z=original.heights[v].z;
+            data.materials=original.materials;
+        }
+        neighbour_weld_edge_heights(*terrain,selection.x,selection.y,strips);
+        neighbour_weld_edge_normals(*terrain,selection.x,selection.y,strips);
+        neighbour_weld_edge_shading(*terrain,selection.x,selection.y,strips);
+        if(whole(selection)){
+            std::vector<TerrainAdjoiningLiquid> beside;
+            TerrainAdjoiningLiquid a;a.offset_x=int(selection.x);a.offset_y=int(selection.y);
+            a.xmax=int(active->sector_count_x*32);a.ymax=int(active->sector_count_y*32);
+            a.rim=active_rim.heights.empty()?nullptr:&active_rim;a.flows=a.fixed=true;beside.push_back(a);
+            for(std::size_t other=0;other<pieces.size();++other){
