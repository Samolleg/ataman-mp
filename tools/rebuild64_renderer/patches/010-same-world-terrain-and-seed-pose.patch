diff --git a/external/owned-renderer/Source/brush_shared_vector.h b/external/owned-renderer/Source/brush_shared_vector.h
new file mode 100644
--- /dev/null
+++ b/external/owned-renderer/Source/brush_shared_vector.h
@@ -0,0 +1,53 @@
+#pragma once
+#include <memory>
+#include <vector>
+#include <utility>
+#include <initializer_list>
+
+namespace owned {
+// Immutable sector publications share their unchanged arrays. A writer owns
+// its sector arrays before mutating them; a const reader never detaches.
+// No background job receives a mutable published terrain.
+template<class T> class BrushSharedVector {
+    using Storage=std::vector<T>;
+    std::shared_ptr<Storage> values_;
+    const Storage& read()const noexcept {static const Storage empty;return values_?*values_:empty;}
+    Storage& write(){if(!values_)values_=std::make_shared<Storage>();else if(!values_.unique())values_=std::make_shared<Storage>(*values_);return *values_;}
+public:
+    using value_type=T;using size_type=typename Storage::size_type;
+    using iterator=typename Storage::iterator;using const_iterator=typename Storage::const_iterator;
+    BrushSharedVector()=default;
+    BrushSharedVector(const BrushSharedVector&)=default;BrushSharedVector(BrushSharedVector&&) noexcept=default;
+    BrushSharedVector& operator=(const BrushSharedVector&)=default;BrushSharedVector& operator=(BrushSharedVector&&) noexcept=default;
+    BrushSharedVector(std::initializer_list<T> values):values_(std::make_shared<Storage>(values)){}
+    BrushSharedVector(const Storage& values):values_(std::make_shared<Storage>(values)){}
+    BrushSharedVector(Storage&& values):values_(std::make_shared<Storage>(std::move(values))){}
+    BrushSharedVector& operator=(Storage values){values_=std::make_shared<Storage>(std::move(values));return *this;}
+    BrushSharedVector& operator=(std::initializer_list<T> values){values_=std::make_shared<Storage>(values);return *this;}
+    operator const Storage&()const noexcept{return read();}
+    operator Storage&(){return write();}
+    bool empty()const noexcept{return read().empty();}
+    size_type size()const noexcept{return read().size();}
+    size_type capacity()const noexcept{return read().capacity();}
+    size_type max_size()const noexcept{return read().max_size();}
+    const T* data()const noexcept{return read().data();}T* data(){return write().data();}
+    const T& operator[](size_type i)const noexcept{return read()[i];}T& operator[](size_type i){return write()[i];}
+    const T& at(size_type i)const{return read().at(i);}T& at(size_type i){return write().at(i);}
+    const T& front()const{return read().front();}T& front(){return write().front();}
+    const T& back()const{return read().back();}T& back(){return write().back();}
+    const_iterator begin()const noexcept{return read().begin();}const_iterator end()const noexcept{return read().end();}
+    const_iterator cbegin()const noexcept{return read().cbegin();}const_iterator cend()const noexcept{return read().cend();}
+    iterator begin(){return write().begin();}iterator end(){return write().end();}
+    void clear()noexcept{values_.reset();}
+    void reserve(size_type n){if(n>capacity())write().reserve(n);}
+    void resize(size_type n){if(n!=size())write().resize(n);}
+    void resize(size_type n,const T& value){if(n!=size())write().resize(n,value);}
+    template<class... A>void assign(A&&... a){auto values=std::make_shared<Storage>();values->assign(std::forward<A>(a)...);values_=std::move(values);}
+    void push_back(const T& value){write().push_back(value);}void push_back(T&& value){write().push_back(std::move(value));}
+    template<class... A>T& emplace_back(A&&... a){return write().emplace_back(std::forward<A>(a)...);}
+    void pop_back(){write().pop_back();}
+    void shrink_to_fit(){if(values_&&values_.unique())values_->shrink_to_fit();}
+    void swap(BrushSharedVector& other)noexcept{values_.swap(other.values_);}
+    void swap(Storage& other){write().swap(other);}
+};
+} // namespace owned
