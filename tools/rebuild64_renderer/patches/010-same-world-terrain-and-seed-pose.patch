+        replacement.brush_contact_map=resident.brush_contact_map;replacement.brush_revision=cache.revision+2;
+        NativePrebuiltBuilder builder;builder.device=device;
+        OwnedTerrainFramePacket packet;packet.source=terrain;packet.inputs.source_generation=resident.epoch;packet.inputs.source_revision=1;
+        OwnedTerrainDynamicSector dynamic;dynamic.captured=true;dynamic.animation.tiles_per_texture_side=terrain->tiles_per_texture_side;
+        const auto geometry=frozen_owned_terrain_geometry(*terrain);
+        for(const auto& draw:resident.terrain){
+            if(cancel->load())return {};
+            if(!dirty.count(draw.sector))continue;
+            if(!geometry_changed&&draw.material<terrain->texture_count+2u)continue;
+            OwnedTerrainCommand command;command.source_sector=draw.sector;command.material=static_cast<std::uint16_t>(draw.material);
+            command.lod=0;command.subpart_mask=15;
+            if(!select_owned_terrain_descriptor_counts(terrain->sectors[draw.sector].materials[draw.material],0,false,false,15,command.tile_count,command.index_count))throw std::runtime_error("neighbour brush CPU preparation failed");
+            command.vertex_count=command.tile_count*terrain_vertices_per_tile(0);
+            OwnedTerrainSourceDecodeContext decode;NativeGeometryView view;
+            if(!source_terrain_view(packet,command,dynamic,decode,view))throw std::runtime_error("neighbour brush CPU preparation failed");
+            decode.geometry=&geometry;
+            view.world.enabled=true;view.world.identity=&terrain->sectors[draw.sector].identity;view.world.part=draw.material;
+            NativePrebuiltMesh mesh;if(!build_native_prebuilt_mesh(builder,view,mesh)){
+                char message[180];std::snprintf(message,sizeof(message),"BRUSH_WELD decode failure map=%s sector=%u material=%u vertices=%u indices=%u",selection.placement.mpr.c_str(),draw.sector,draw.material,command.vertex_count,command.index_count);bridge_neighbour_diagnostic(message);throw std::runtime_error("neighbour brush CPU preparation failed");
+            }
+            auto next=draw;next.mesh=static_cast<std::uint32_t>(replacement.meshes.size());next.geometry_revision=view.geometry_revision;
+            NativeWorldBounds bounds;if(!owned_terrain_command_bounds(*terrain,command,geometry,bounds))throw std::runtime_error("neighbour brush CPU preparation failed");
+            next.bounds_minimum=bounds.minimum;next.bounds_maximum=bounds.maximum;
+            replacement.meshes.push_back(std::move(mesh));replacement.terrain.push_back(std::move(next));
+        }
