+    std::uint32_t sx,std::uint32_t sy,TerrainSectorCpuAsset& output,ResourceFailure& failure) {
+    if(!sector_blob.bytes||sector_blob.bytes->size()<5||sx>=terrain.sector_count_x||sy>=terrain.sector_count_y){
