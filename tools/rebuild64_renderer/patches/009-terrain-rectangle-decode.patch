+        if (encoded == kTerrainUndefined) return false;
+        const std::uint32_t tile_index = encoded & 0x3fffu;
+        if (tile_index >= terrain.tile_types.size()) return false;
+        std::uint16_t material = 0;
+        std::uint32_t tile_position = 0;
