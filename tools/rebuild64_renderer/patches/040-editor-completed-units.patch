+#ifdef EID3D11_EMBEDDED
+bool RetainedStaticScene::visual_editor_pose(std::int32_t id,
+    std::shared_ptr<const VisualAssemblyAsset> assembly,
+    const VisualObjectPose& pose, bool unit) noexcept {
+    std::array<float,16> matrix{};
+    if (!retained_object_matrix(pose.position,pose.quaternion,matrix) ||
+        !std::all_of(pose.shape.begin(),pose.shape.end(),[](float x){return std::isfinite(x);}) ||
+        !std::isfinite(pose.phase) || pose.phase<0 ||
+        (!pose.selection.neutral && (!pose.selection.database || !pose.selection.clip ||
+            pose.selection.ordinal>=pose.selection.database->entries.size())))return false;
+    if(assembly) {
+        auto neutral=pose;neutral.selection={nullptr,nullptr,0,true};neutral.phase=0;
+        if(!visual_seed(id,std::move(assembly),neutral))return false;
+    }
+    ExclusiveLock guard(lock_);
+    const auto found=detached_.find(id);
+    if(found==detached_.end()||!found->second.seeded)return false;
+    auto& entity=found->second.entity;
+    const bool envelope=entity.object_pose.shape!=pose.shape ||
+        !same_selection(entity.object_pose.selection,pose.selection);
+    entity.completed_pose=true;entity.tick.unit=unit;
+    entity.object_pose=pose;entity.has_object_pose=true;
+    if(envelope&&!visual_refresh_envelope(entity,false))return false;
+    ++entity.pose_revision;visual_values_changed_unlocked(id);detached_changed_unlocked();
+    return true;
+}
