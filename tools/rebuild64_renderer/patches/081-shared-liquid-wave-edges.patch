+std::vector<std::array<float,4>> neighbour_liquid_wave_seams(const std::string& mpr) {
+    std::vector<std::array<float,4>> seams;
+    if(!neighbour_maps_enabled())return seams;
+    try {
+        const auto layout=parse_neighbour_layout(read_layout(layout_file()));
+        const auto& active=neighbour_layout_active(layout,"deja-vu",map_name(mpr));
+        for(const auto& n:select_neighbour_layout(layout,"deja-vu",map_name(mpr))) {
+            const double loX=(std::max)(0.,n.x),hiX=(std::min)(active.width,n.x+n.placement.width);
+            const double loY=(std::max)(0.,n.y),hiY=(std::min)(active.height,n.y+n.placement.height);
+            if(hiY>loY) {
+                if(n.x==active.width)seams.push_back({float(active.width),float(loY),float(active.width),float(hiY)});
+                if(n.x+n.placement.width==0)seams.push_back({0,float(loY),0,float(hiY)});
+            }
+            if(hiX>loX) {
+                if(n.y==active.height)seams.push_back({float(loX),float(active.height),float(hiX),float(active.height)});
+                if(n.y+n.placement.height==0)seams.push_back({float(loX),0,float(hiX),0});
+            }
+        }
+    }catch(...) {seams.clear();} // No unconfirmed contact changes a liquid vertex.
+    return seams;
+}
